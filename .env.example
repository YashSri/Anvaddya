# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real keys.

# Resend API key (https://resend.com/api-keys). Required for the partnership enquiry form.
RESEND_API_KEY=

# Inbox that receives partnership enquiries.
ENQUIRY_TO_EMAIL=contact@anvaddya.com

# Sender shown on enquiry emails. Must be on a domain verified in Resend.
# Until anvaddya.com is verified, use Resend's test sender: "Anvaddya Orbit <onboarding@resend.dev>"
# (the test sender can only deliver to the email address that owns the Resend account).
ENQUIRY_FROM_EMAIL=Anvaddya Orbit <onboarding@resend.dev>

# Public site URL, used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.anvaddya.com

# Optional: Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# Leave empty to disable analytics entirely — no cookie banner is shown when unset.
# When set, GA loads only after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
